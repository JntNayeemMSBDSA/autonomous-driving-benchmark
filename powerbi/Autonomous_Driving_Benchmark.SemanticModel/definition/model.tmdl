model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_company", "dim_date", "dim_geography", "dim_source", "dim_technology", "fact_av_incident", "fact_deployment_mileage", "fact_company_capability", "fact_partnership", "fact_gpu_pricing", "fact_training_cost_scenario", "fact_cost_sensitivity", "fact_scalability_score", "fact_safety_indicator", "bridge_company_technology", "qa_validation_result", "scalability_criteria", "weighting_scheme"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_company
ref table dim_date
ref table dim_geography
ref table dim_source
ref table dim_technology
ref table fact_av_incident
ref table fact_deployment_mileage
ref table fact_company_capability
ref table fact_partnership
ref table fact_gpu_pricing
ref table fact_training_cost_scenario
ref table fact_cost_sensitivity
ref table fact_scalability_score
ref table fact_safety_indicator
ref table bridge_company_technology
ref table qa_validation_result
ref table scalability_criteria
ref table weighting_scheme

ref cultureInfo en-US

