				    Source = Excel.Workbook(File.Contents("C:\Users\janna\Desktop\New folder\Projects\autonomous_driving_benchmark\autonomous_driving_benchmark\powerbi\powerbi_ready_data.xlsx"), null, true),
				    Data = Source{[Item="CostSensitivity",Kind="Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Data,{{"sensitivity_id", Int64.Type}, {"scenario_id", Int64.Type}, {"scenario_name", type text}, {"cloud_provider", type text}, {"instance_type", type text}, {"variable", type text}, {"parameter_value", type number}, {"total_cost_usd", type number}, {"baseline_total_cost_usd", type number}, {"change_from_baseline_pct", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

