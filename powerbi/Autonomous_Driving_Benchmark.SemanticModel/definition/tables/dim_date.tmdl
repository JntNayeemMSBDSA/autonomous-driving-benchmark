table dim_date

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: full_date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: year

	column quarter
		dataType: string
		summarizeBy: none
		sourceColumn: quarter

	column month_number
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: month_number

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column cutoff_valid
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: cutoff_valid

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\janna\Desktop\New folder\Projects\autonomous_driving_benchmark\autonomous_driving_benchmark\powerbi\powerbi_ready_data.xlsx"), null, true),
				    Data = Source{[Item="DimDate",Kind="Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Data,{{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_number", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"cutoff_valid", Int64.Type}})
				in
				    #"Changed Type"

	annotation __PBI_DateTable = true

	annotation PBI_ResultType = Table

